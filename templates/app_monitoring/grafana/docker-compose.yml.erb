services:
    grafana:
        image: grafana/grafana
        container_name: grafana
        restart: always
        working_dir: '<%= @grafanaDirectory %>'
        
        ports:
            - "<%= @config['port'] %>:3000"
        
        networks:
            - grafana-net
        
        volumes:
            - grafana-storage:/var/lib/grafana
            - ./datasources:/etc/grafana/provisioning/datasources
            - ./dashboards:/etc/grafana/provisioning/dashboards
        
        environment:
            GF_AUTH_ANONYMOUS_ENABLED: true
            
            # add plugins if you want
            #GF_INSTALL_PLUGINS: []

<% if @config['dataSources']['prometheus']['enabled'] -%>

<% if @config['dataSources']['prometheus']['alertmanager']['enabled'] -%>
    alertmanager:
        image: prom/alertmanager:latest
        container_name: alertmanager
        restart: unless-stopped
        working_dir: '<%= @grafanaDirectory %>'
        
        ports:
          - "<%= @config['dataSources']['prometheus']['alertmanager']['port'] %>:9093"
        
        volumes:
            - ./configs/alertmanager-blackbox.yml:/etc/alertmanager/alertmanager.yml
            - alertmanager_data:/alertmanager
        
        networks:
            - grafana-net
<% end -%>

<% @config['dataSources']['prometheus']['exporters'].each do |exporter, exporterConfig| -%>

<% if exporter == 'node' -%>
    node-exporter:
        image: prom/node-exporter:latest
        container_name: node-exporter
        restart: unless-stopped
        volumes:
            - /proc:/host/proc:ro
            - /sys:/host/sys:ro
            - /:/rootfs:ro
        command:
            - '--path.procfs=/host/proc'
            - '--path.rootfs=/rootfs'
            - '--path.sysfs=/host/sys'
            - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
        
        ports:
            - "<%= exporterConfig['port'] %>:9100"
        
        expose:
            - <%= exporterConfig['port'] %>
        
        networks:
            - grafana-net
<% end -%>

<% if exporter == 'blackbox' -%>
    blackbox-exporter:
        image: prom/blackbox-exporter:latest
        container_name: blackbox-exporter
        restart: unless-stopped
        
        ports:
            - "<%= exporterConfig['port'] %>:9115"
        
        expose:
            - <%= exporterConfig['port'] %>
        
        networks:
            - grafana-net
<% end -%>

<% end -%>

    prometheus:
        image: prom/prometheus:latest
        container_name: prometheus
        restart: unless-stopped
        working_dir: '<%= @grafanaDirectory %>'
        
        volumes:
            - ./configs/prometheus.yml:/etc/prometheus/prometheus.yml
            - ./rules:/etc/prometheus/rules # Matches "rules/*.yml" relative to /etc/prometheus/
            - prometheus_data:/prometheus
        command:
            - '--config.file=/etc/prometheus/prometheus.yml'
            - '--storage.tsdb.path=/prometheus'
            - '--web.console.libraries=/etc/prometheus/console_libraries'
            - '--web.console.templates=/etc/prometheus/consoles'
            - '--web.enable-lifecycle'
        
        ports:
            - "<%= @prometheusConfig['port'] %>:9090"
        
        expose:
            - <%= @prometheusConfig['port'] %>
        
        networks:
            - grafana-net
<% end -%>

<% if @config['dataSources']['graphite']['enabled'] -%>
    graphite:
        image: graphiteapp/graphite-statsd
        container_name: graphite
        restart: always
        working_dir: '<%= @grafanaDirectory %>'
        
        ports:
            - "<%= @config['dataSources']['graphite']['port'] %>:80"
            - "2003-2004:2003-2004"
            - "2023-2024:2023-2024"
            - "8125:8125/udp"
            - "8126:8126"
        
        expose:
            - <%= @config['dataSources']['graphite']['port'] %>
        
        networks:
            - grafana-net
        
        volumes:
            - /[install path]/configs:/opt/graphite/conf
            - /[install path]/data:/opt/graphite/storage
            - /[install path]/statsd_config:/opt/statsd/config
<% end -%>

networks:
    grafana-net:
        external: true

volumes:
    grafana-storage:
        external: true
    prometheus_data:
    alertmanager_data:
