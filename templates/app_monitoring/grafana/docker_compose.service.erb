[Unit]
Description=Mercure Hub
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=<%= @grafanaDirectory %>

ExecStart=/usr/bin/docker compose -f <%= @grafanaDirectory %>/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f <%= @grafanaDirectory %>/docker-compose.yml down

[Install]
WantedBy=multi-user.target