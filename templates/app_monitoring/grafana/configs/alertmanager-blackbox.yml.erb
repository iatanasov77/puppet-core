route:
    group_by: ['alertname']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 2m
    receiver: 'web.hook'
receivers:
    - name: 'web.hook'
      webhook_configs:
        - url: 'https://webhook.site/38781db7-3ed5-4508-94fc-8b18afdcefff'
inhibit_rules:
    - source_match:
        severity: 'critical'
      target_match:
        severity: 'warning'
      equal: ['alertname', 'dev', 'instance']
