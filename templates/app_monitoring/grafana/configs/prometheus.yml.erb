global:
    scrape_interval: <%= @prometheusConfig['scrapeInterval'] %>
    evaluation_interval: <%= @prometheusConfig['scrapeInterval'] %>

<% if @prometheusConfig['alertmanager']['enabled'] -%>
rule_files:
    - "rules/*.yml"

alerting:
    alertmanagers:
    - static_configs:
        - targets:
            - <%= @prometheusConfig['alertmanager']['alertmanagerUrl'] %>
<% end -%>

scrape_configs:
    - job_name: 'prometheus'
      static_configs:
        - targets: ['<%= @prometheusConfig['host'] %>:<%= @prometheusConfig['port'] %>']

<% @prometheusConfig['exporters'].each do |exporter, config| -%>
    - job_name: '<%= exporter %>'
      static_configs:
        - targets: <%= config['targets'] %>

<% if exporter == 'blackbox' -%>
      metrics_path: /probe
      relabel_configs:
        - source_labels: [__address__]
          target_label: __param_target
        - source_labels: [__param_target]
          target_label: instance
        - target_label: __address__
          replacement: <%= config['blackboxUrl'] %>
<% end -%>

<% if exporter == 'mercure' -%>
      metrics_path: '/metrics'
<% end -%>

<% end -%>
